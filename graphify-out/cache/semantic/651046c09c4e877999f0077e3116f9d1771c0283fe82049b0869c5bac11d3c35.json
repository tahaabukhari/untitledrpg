{"nodes": [{"id": "player_animator_playeranimator", "label": "PlayerAnimator (code-driven puppet)", "file_type": "code", "source_file": "player_animator.gd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds core locomotion anims programmatically; weapon-specific anims come from WeaponAnimator plugins loaded from weapon_data.animator_script. Animation tuning exposed as @export so it can be dialed from the Inspector, baked at _ready()."}, {"id": "player_animator_equip_weapon_visual", "label": "PlayerAnimator.equip_weapon_visual", "file_type": "code", "source_file": "player_animator.gd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CRASH GUARD: anim_player.stop() before mutating the animation library \u2014 replacing a track while it is being evaluated leaves stale track caches and segfaults (Godot 4.3)."}, {"id": "player_animator_play_state", "label": "PlayerAnimator.play_state", "file_type": "code", "source_file": "player_animator.gd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "player_animator_play_attack", "label": "PlayerAnimator.play_attack", "file_type": "code", "source_file": "player_animator.gd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combo-aware, 8-way aim-quantized. Horizontal aim uses the weapon's authored combo_anims; other octants build (and cache) an angle-parameterized swing via WeaponAnimator.make_directional_swing."}, {"id": "player_animator_play_uppercut", "label": "PlayerAnimator.play_uppercut", "file_type": "code", "source_file": "player_animator.gd", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plays the equipped weapon's charged_anim (falls back to 'uppercut'). Reused by charged melee, la