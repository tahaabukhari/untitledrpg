{"nodes": [{"id": "docs_combat_dodge_trip_mirror_md", "label": "COMBAT_DODGE_TRIP_MIRROR.md", "file_type": "document", "source_file": "docs/COMBAT_DODGE_TRIP_MIRROR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_dodge_trip_mirror", "label": "Directional dodge / tripping / mirror combat mechanic", "file_type": "concept", "source_file": "docs/COMBAT_DODGE_TRIP_MIRROR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Directional dodge (leap/slide/roll from movement input); sliding under a BIPED trips it (DOWNED 2s, bonus damage). Tripping is a symmetric shared verb: player trips monsters and monsters trip the player. The Mirror Warrior shows the whole kit off from the other side."}, {"id": "concept_bipedal_trip_rule", "label": "Bipedal-only trip rule", "file_type": "rationale", "source_file": "docs/COMBAT_DODGE_TRIP_MIRROR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HARD RULE: you can only sweep the legs from something with two legs. EnemyBase.trippable defaults false; set true only on humanoids (player + Mirror Warrior). Slime/bombug/mannequin/whisperer/boss are immune by nature. Declarative and impossible to forget per-monster."}, {"id": "concept_slide_trip_chance", "label": "Slide-trip chance-roll + stamina cost", "file_type": "rationale", "source_file": "docs/COMBAT_DODGE_TRIP_MIRROR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A slide always passes through with i-frames (evade), but the knockdown only lands on a roll: player SLIDE_TRIP_CHANCE=0.6, Mirror=0.3, per opponent-per-slide. A successful knockdown costs +50 stamina; trip() returns bool so the slider only pays on a real knockdown."}, {"id": "concept_hit_fx_blood_routing", "label": "hit_fx blood routing", "file_type": "rationale", "source_file": "docs/COMBAT_DODGE_TRIP_MIRROR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EnemyBase.hit_fx routes take_damage to the matching Fx reaction (flesh bleeds via Fx.blood_spray, goo default). Keeps entity-specific reactions declarative; only the Mirror is flesh for now."}], "edges": [{"source": "docs_combat_dodge_trip_mirror_md", "target": "docs_architecture_md", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/COMBAT_DODGE_TRIP_MIRROR.md", "source_location": null, "weight": 1.0}, {"source": "docs_combat_dodge_trip_mirror_md", "target": "docs_weapon_item_architecture_md", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/COMBAT_DODGE_TRIP_MIRROR.md", "source_location": null, "weight": 1.0}, {"source": "docs_combat_dodge_trip_mirror_md", "target": "concept_dodge_trip_mirror", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/COMBAT_DODGE_TRIP_MIRROR.md", "source_location": null, "weight": 1.0}, {"source": "docs_combat_dodge_trip_mirror_md", "target": "concept_bipedal_trip_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/COMBAT_DODGE_TRIP_MIRROR.md", "source_location": null, "weight": 1.0}, {"source": "docs_combat_dodge_trip_mirror_md", "target": "concept_slide_trip_chance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/COMBAT_DODGE_TRIP_MIRROR.md", "source_location": null, "weight": 1.0}, {"source": "docs_combat_dodge_trip_mirror_md", "target": "concept_hit_fx_blood_routing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/COMBAT_DODGE_TRIP_MIRROR.md", "source_location": null, "weight": 1.0}, {"source": "concept_dodge_trip_mirror", "target": "enemies_mirr